<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos del circulo infernal</title>
</head>
<body>
    <main class="container">
        <table class="table" border="1">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Docente</th>
                </tr>
            </thead>
            <%
            if(Array.isArray(cursos) && cursos.length > 0){
            %>
            <tbody>
                <% cursos.forEach(function(curso){ %>
                    <td><%= curso.id %></td>
                    <td><%= curso.nombre %></td>
                    <td><%= curso.descripcion %></td>
                    <td><%= curso.docente %></td>
                <% }); %>
            </tbody>
        </table>
        <% } else { %>
            <div>No hay cursos disponibles right now, hay un error al cargarlos</div>
            <p><a href="../Views/bienvenida.html">Volver a bienvenida</a></p>
        <% } %>
    </main>
</body>
</html>